    <title>Apartment for Rent</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <header>
        <h1>Apartment for Rent</h1>
        <nav>
            <ul>
                <li><a href="#details">Details</a></li>
                <li><a href="#photos">Photos</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <section id="details">
        <h2>Property Details</h2>
        <p>Description of the apartment, including number of bedrooms, bathrooms, location, and special features.</p>
    </section>

    <section id="photos">
        <h2>Photos</h2>
        <div class="photo-gallery">
            <img src="photo1.jpg" alt="Living Room">
            <img src="photo2.jpg" alt="Bedroom">
            <img src="photo3.jpg" alt="Kitchen">
        </div>
    </section>

    <section id="contact">
        <h2>Contact Information</h2>
        <p>Your Name</p>
        <p>Phone: 123-456-7890</p>
        <p>Email: youremail@example.com</p>
    </section>

    <footer>
        <p>&copy; 2025 Your Name. All rights reserved.</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
